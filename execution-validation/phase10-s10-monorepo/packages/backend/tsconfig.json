{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@todo/domain": ["../domain/dist/index.d.ts"],
      "@todo/domain/*": ["../domain/dist/*"]
    }
  },
  "include": ["src/**/*"]
}