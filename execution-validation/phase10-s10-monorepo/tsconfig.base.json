{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@todo/domain/*": ["packages/domain/src/*"]
    }
  },
  "exclude": ["node_modules", "**/*.test.ts"]
}